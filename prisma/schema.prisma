// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  passwordHash       String
  emailVerified      DateTime?
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  /// "NGN" or "USD", never any other value: a CHECK constraint enforces
  /// this at the database level (see the two_currency_model migration),
  /// since Prisma has no first-class enum-backed CHECK for an existing
  /// String column here. NGN for Nigeria, USD for every other supported
  /// country — never a currency per country. Chosen at registration (see
  /// currencyForCountry() in src/lib/currency-config.ts) and never silently
  /// reinterpreted: changing a currency after money has moved would make
  /// every past amount mean something different than what it said at the
  /// time. Enforced by omission rather than a guard: nothing outside
  /// registerAction() in src/app/(auth)/register/actions.ts ever writes
  /// this column, so there is no code path that could change it later.
  currency           String     @default("NGN")
  walletBalanceKobo Int       @default(0)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean   @default(false)
  /// Consecutive wrong password or TOTP guesses since the last successful
  /// one of either. Shared between both steps deliberately: a login is one
  /// attempt to get into one account regardless of which factor is being
  /// guessed, so there is one budget, not two independent ones to exhaust
  /// separately. Reset to 0 on any successful password or TOTP check.
  failedLoginAttempts Int      @default(0)
  /// Set once failedLoginAttempts crosses the threshold in
  /// src/lib/login-lockout.ts; both the password and TOTP checks refuse to
  /// even attempt a comparison while this is in the future, which is what
  /// actually stops unlimited guessing rather than just counting it.
  lockedUntil        DateTime?
  /// Set the moment a sign-in succeeds. Used for "last active" in the admin
  /// user profile and for email targeting ("hasn't logged in recently");
  /// null means never recorded, either because the account has never signed
  /// in since this field was added, or has never signed in at all.
  lastLoginAt        DateTime?
  /// Set instead of removing the row. Financial and order history
  /// (Activation, WalletTransaction) reference this user and must survive
  /// account deletion intact, so "permanently delete" anonymises this row
  /// rather than removing it. Null means the account is live.
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  manualVerificationRequests ManualVerificationRequest[]
  activations             Activation[]
  walletTransactions      WalletTransaction[]
  supportTickets          SupportTicket[]
  notifications           Notification[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// Set the moment this exact token successfully verifies an account.
  /// Mirrors PasswordResetToken.usedAt. Kept as a row (not deleted) once
  /// used, unlike the pre-existing behaviour, so a second visit to the same
  /// link — a browser re-opening it, an email scanner that already followed
  /// it once, the user clicking it twice — can be told "you're already
  /// verified" instead of the generic "invalid or expired" a deleted row
  /// would otherwise produce indistinguishably from a token that never
  /// existed. Checked by verifyEmailToken() in src/lib/verification.ts,
  /// which is the only place this is ever set.
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

enum ManualVerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A customer's own request for an admin to verify their email by hand,
/// for when they cannot receive or complete the automated link (resend
/// limit reached, a mail provider outage, a broken inbox). See
/// src/lib/verification.ts for creation and src/app/admin/verification for
/// the review UI. Deliberately outside EmailVerificationToken: this is a
/// request for a human decision, not another automated capability, and
/// mixing the two shapes into one table would make neither easy to reason
/// about.
model ManualVerificationRequest {
  id         String                           @id @default(cuid())
  userId     String
  user       User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     ManualVerificationRequestStatus  @default(PENDING)
  /// What the customer said, when the form collects a reason. Optional:
  /// the request is valid without one, since "my inbox isn't working" is
  /// not always a thing someone can articulate further.
  reason     String?
  /// The admin who reviewed this, by email rather than a relation — the
  /// same reasoning as AuditLog.actorEmail: the record must stay legible
  /// even if that admin account is later changed or removed.
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime                         @default(now())

  @@index([userId])
  @@index([status])
  @@map("manual_verification_requests")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

enum ActivationStatus {
  /// Bought, waiting on the code. "Pending" in the admin.
  WAITING
  /// Code delivered. "Completed" in the admin.
  RECEIVED
  /// Session ended with no code. "Failed" in the admin.
  EXPIRED
  CANCELLED
  /// The supplier refunded the order on its side. Distinct from EXPIRED so
  /// the admin can tell a timed-out order apart from a supplier refund.
  REFUNDED
}

/// One number purchase. Carries its own economics: an order Xencodes cannot
/// answer "what did this cost, what did it earn" for should never have been
/// placed, so every figure that answers it is written at purchase time.
model Activation {
  id          String           @id @default(cuid())
  userId      String
  /// Restrict, not cascade: an order is financial history and must outlive
  /// the account it was placed under. A user is never SQL-deleted (see
  /// User.deletedAt); this is a safety rail against that ever changing by
  /// accident, since a cascade here would silently erase profit history.
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  serviceSlug String
  serviceName String
  countrySlug String
  countryName String
  phoneNumber String
  /// Which supplier filled this order. Named generically and stored per
  /// order so historical orders stay readable after a supplier change,
  /// without the old one's name leaking into new business logic.
  provider    String
  /// The supplier's own id for this order, used to poll for the SMS.
  providerOrderId String?
  /// The supplier's own id for the service bought, captured at purchase
  /// time (e.g. GrizzlySMS's "wa" for WhatsApp). Reporting only: nothing
  /// reads this back to talk to the supplier, since providerOrderId alone
  /// is enough to poll status or cancel.
  providerServiceId String?
  /// The supplier's own id for the country bought, captured the same way.
  providerCountryId String?
  /// "NGN" or "USD" (CHECK-constrained, see User.currency's own comment):
  /// what priceKobo/providerCostKobo/grossProfitKobo are all denominated
  /// in, the buyer's own currency at the moment of purchase (User.currency),
  /// captured here rather than looked up from the user record so a
  /// historical order stays correctly labelled even if that were ever
  /// revisited.
  currency    String           @default("NGN")
  /// What the customer paid, in `currency` above.
  priceKobo  Int
  /// What the supplier billed Xencodes for this exact order, converted from
  /// its native USD into `currency` at the admin-configured rate that was
  /// live at purchase time, and captured here rather than recomputed
  /// because both a supplier's USD price and the USD/currency rate move: an
  /// order's margin has to be answerable later from what was true when it
  /// was placed.
  providerCostKobo Int @default(0)
  /// priceKobo minus providerCostKobo, stored for the same reason. Gross
  /// margin is derived from these two rather than stored, so it can never
  /// disagree with the money.
  grossProfitKobo Int @default(0)
  /// The margin the pricing rule asked for, and which rule that was, so an
  /// order's price stays explainable after the rules change.
  targetMarginPercent Int @default(0)
  pricingRule String @default("legacy")
  status      ActivationStatus @default(WAITING)
  code        String?
  expiresAt   DateTime
  receivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("activations")
}

enum WalletTransactionType {
  TOPUP
  PURCHASE
  REFUND
  /// Manual correction made by an admin, credit or debit.
  ADJUSTMENT
}

enum WalletTransactionStatus {
  /// Money has been asked for but not received. A pending row must never
  /// have contributed to the user's balance.
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
}

model WalletTransaction {
  id          String                @id @default(cuid())
  userId      String
  /// Restrict, not cascade: see the matching note on Activation.user.
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  type        WalletTransactionType
  amountKobo Int
  description String
  /// "NGN" or "USD" (CHECK-constrained, see User.currency's own comment).
  /// Stored per row rather than assumed globally so NGN and USD movements
  /// are never blended into one sum by an aggregate query.
  currency    String                @default("NGN")
  /// Defaults to SUCCESSFUL because every row that existed before funding
  /// was introduced was an already-settled purchase, refund or adjustment.
  /// Only a top-up ever starts life PENDING.
  status      WalletTransactionStatus @default(SUCCESSFUL)
  /// The payment provider that owns this movement, for example "korapay".
  /// Null for internal movements like a purchase or an admin adjustment.
  provider    String?
  /// Our reference, generated before the provider is called and passed to
  /// it, so a webhook arriving later can be matched back to this exact row.
  /// Unique because it is what makes crediting idempotent.
  providerReference String?         @unique
  /// The provider's own id for the payment, recorded once it is known.
  providerTransactionId String?
  /// When the money actually landed, as distinct from when it was asked for.
  completedAt DateTime?
  failureReason String?
  /// The order this movement belongs to, for a purchase or its refund. Null
  /// for a top up or an admin adjustment, which are not about one order.
  /// Not a relation: an order can be deleted with its customer while the
  /// ledger row stays as history.
  activationId String?
  createdAt   DateTime              @default(now())

  @@index([userId])
  @@index([status])
  @@index([activationId])
  @@map("wallet_transactions")
}

/// Admin override for one service. An absent row, or a null margin, means
/// the service follows the platform rules in src/lib/pricing.ts.
model ServiceSetting {
  slug              String   @id
  enabled           Boolean  @default(true)
  /// Explicit gross margin for this service, as a percent of the customer
  /// price. Null rather than zero for "no override": zero is a real and
  /// very different instruction, namely sell at cost.
  grossMarginPercent Int?
  updatedAt         DateTime @updatedAt

  @@map("service_settings")
}

/// Small key/value store for platform settings (pricing defaults, provider config).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// A record of a destructive or otherwise sensitive action an admin took.
/// Append-only from the app's side: nothing in src/app or src/lib updates or
/// deletes a row here once written.
model AuditLog {
  id         String   @id @default(cuid())
  /// The admin who performed the action. Not a relation to User: an audit
  /// row must remain legible even after the admin account itself is later
  /// suspended, changed, or (in principle) removed, so the identifying
  /// details are captured as plain values at the moment of the action.
  actorId    String
  actorEmail String
  /// A short, stable verb, e.g. "user.suspend", "user.delete",
  /// "wallet.adjust", "email.send", "settings.update".
  action     String
  /// What the action was performed on, e.g. "user", "wallet_transaction",
  /// "email_campaign", "settings".
  targetType String
  /// The affected row's id, when the action has one specific target.
  targetId   String?
  /// Free-form detail specific to the action (previous/new values, amounts,
  /// audience definitions, and so on), kept as JSON rather than one column
  /// per possible action so this table does not need a migration every time
  /// a new kind of admin action is added.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum SupportMessageAuthor {
  USER
  ADMIN
}

/// A support conversation with one customer. Deliberately thin: a subject,
/// a status, an optional link to the order it is about, and a thread of
/// messages. Not a full helpdesk — see SupportMessage.
model SupportTicket {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject            String
  status             SupportTicketStatus @default(OPEN)
  /// The order this ticket is about, if any. Not a relation, matching
  /// WalletTransaction.activationId: a ticket must stay readable even if the
  /// order it references is ever removed.
  relatedActivationId String?
  messages           SupportMessage[]
  notifications      Notification[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id        String                @id @default(cuid())
  ticketId  String
  ticket    SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    SupportMessageAuthor
  /// The admin who wrote this message, when the author is ADMIN. Plain
  /// value rather than a relation, for the same reason as AuditLog.actorId.
  adminEmail String?
  body      String
  createdAt DateTime              @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

/// An in-dashboard notification, currently only ever raised by the support
/// system: one row per (recipient, event), so an admin opening a ticket
/// only ever marks *their own* copy read, never another admin's, and a
/// customer's unread badge is a real count of rows they have not yet
/// opened rather than anything computed or trusted from the client.
model Notification {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// Null until markTicketNotificationsRead() (src/lib/notifications.ts)
  /// sets it, which only happens when the recipient's own server-rendered
  /// view of that exact ticket loads — never from a client-side action, so
  /// this can't be forged into "read" without the ticket actually having
  /// been opened.
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, readAt])
  @@index([ticketId])
  @@map("notifications")
}

enum EmailCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

/// The health of the background catalog sync, one row per provider (see
/// src/lib/provider-sync.ts). Read by the admin Providers page and by the
/// browse-side cache in src/lib/inventory.ts to decide whether that
/// provider's SyncedOffer rows are fresh enough to serve. A purchase never
/// reads this: quotePair() in inventory.ts always asks the live provider
/// directly, so a stale or failed sync can make browsing degrade but can
/// never make a purchase wrong.
model ProviderSyncStatus {
  /// The provider's own registry id (see src/lib/provider/registry.ts),
  /// e.g. "grizzlysms". One row per provider, upserted in place. Before
  /// multiple providers existed this was always "singleton"; a migration
  /// renamed that one row's id to "grizzlysms" so its sync history survived
  /// the change.
  id                 String    @id
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  lastFailureError   String?
  servicesSynced     Int?
  countriesSynced    Int?
  /// How many service/country pairs were priced and written to
  /// SyncedOffer on the last successful run.
  offersSynced       Int?
  updatedAt          DateTime  @updatedAt

  @@map("provider_sync_status")
}

/// A cached, already-priced service/country offer, written by the
/// background sync (src/lib/provider-sync.ts) and read by the browse and
/// search paths in src/lib/inventory.ts so a page view or a search
/// keystroke does not call the live supplier. Replaced wholesale on every
/// successful sync run, never partially patched, so a row here is never
/// older than the last full sync and never mixes two runs.
///
/// Never read at purchase time. The price a customer is actually charged
/// always comes from a fresh, uncached call to the provider in
/// quotePair(), which is what keeps a sync outage or a stale cache from
/// ever being able to overcharge, undercharge, or sell something no
/// longer in stock.
model SyncedOffer {
  id             String   @id @default(cuid())
  /// Which provider this exact offer came from (registry id, e.g.
  /// "grizzlysms"). Two providers can each have their own row for the same
  /// serviceSlug/countrySlug pair, at different costs and stock; the
  /// browse-side read in inventory.ts picks the best one across providers,
  /// the way quotePair() does live at purchase time.
  providerId     String   @default("grizzlysms")
  serviceSlug    String
  serviceName    String
  serviceColor   String
  category       String
  countrySlug    String
  countryName    String
  countryFlag    String
  dialCode       String
  nationalDigits Int
  /// What the supplier billed, in USD cents, at sync time. Always USD
  /// regardless of which currency a customer eventually pays in: GrizzlySMS
  /// (and every provider in this API family) bills Xencodes in USD no
  /// matter who the end customer is or what they are charged. Converting
  /// this into a customer's own currency is quotePair()'s job, live, at the
  /// rate in effect for that specific currency; this cache never does that
  /// conversion itself. Never shown to a customer.
  costUsdCents   Int
  /// An illustrative price only, in the platform's default currency (see
  /// src/lib/currency-config.ts), run through the same margin rules
  /// quotePair() uses. Used for browsing/highlight figures (a homepage
  /// "starting price", the admin services list) where showing one
  /// representative number is enough. Never what anyone is actually
  /// charged: quotePair() always recomputes fresh, in the buyer's own
  /// currency, at purchase time, and never reads this column.
  priceKobo      Int
  stock          String
  stockCount     Int
  syncedAt       DateTime @default(now())

  @@unique([serviceSlug, countrySlug, providerId])
  @@index([serviceSlug])
  @@index([countrySlug])
  @@index([providerId])
  @@map("synced_offers")
}

/// One send of a marketing/announcement email to a targeted audience.
/// History only: an admin composes and sends from src/app/admin/email, and
/// this is the record of what was sent, to how many people, and by whom.
/// Individual per-recipient delivery is not tracked as separate rows, to
/// keep this proportional to what an early-stage product needs; sentCount
/// and failedCount are the delivery summary.
model EmailCampaign {
  id             String              @id @default(cuid())
  adminId        String
  adminEmail     String
  subject        String
  previewText    String?
  /// Human-readable label for who this was sent to, e.g. "All users" or
  /// "Funded, never purchased". Kept alongside the machine definition so
  /// the history reads clearly even if the targeting rules change later.
  audienceLabel  String
  /// The targeting rule actually used, e.g. {"segment":"never_purchased"}
  /// or {"segment":"selected","userIds":[...]}. Kept for reference, not
  /// re-evaluated after the fact.
  audienceFilter Json
  recipientCount Int
  sentCount      Int                 @default(0)
  failedCount    Int                 @default(0)
  status         EmailCampaignStatus @default(DRAFT)
  /// Why delivery failed, when it did. Carries the provider's own reason
  /// (a rejected domain, a missing API key) rather than a generic label,
  /// since that is the only thing that tells an admin what to fix.
  failureReason  String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([createdAt])
  @@map("email_campaigns")
}
