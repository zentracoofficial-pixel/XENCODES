// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  passwordHash       String
  emailVerified      DateTime?
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  walletBalanceKobo Int       @default(0)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  activations             Activation[]
  walletTransactions      WalletTransaction[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

enum ActivationStatus {
  WAITING
  RECEIVED
  EXPIRED
  CANCELLED
}

model Activation {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceSlug String
  serviceName String
  countrySlug String
  countryName String
  phoneNumber String
  priceKobo  Int
  status      ActivationStatus @default(WAITING)
  code        String?
  deliverAt   DateTime
  expiresAt   DateTime
  receivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@map("activations")
}

enum WalletTransactionType {
  TOPUP
  PURCHASE
  REFUND
  /// Manual correction made by an admin, credit or debit.
  ADJUSTMENT
}

model WalletTransaction {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        WalletTransactionType
  amountKobo Int
  description String
  createdAt   DateTime              @default(now())

  @@index([userId])
  @@map("wallet_transactions")
}

/// Admin override for a catalog service. Absent row means default (enabled, no markup).
model ServiceSetting {
  slug          String   @id
  enabled       Boolean  @default(true)
  markupPercent Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("service_settings")
}

/// Admin override for a catalog country.
model CountrySetting {
  slug      String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("country_settings")
}

/// Small key/value store for platform settings (global markup, provider config).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
