// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  passwordHash       String
  emailVerified      DateTime?
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  walletBalanceKobo Int       @default(0)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  activations             Activation[]
  walletTransactions      WalletTransaction[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

enum ActivationStatus {
  WAITING
  RECEIVED
  EXPIRED
  CANCELLED
  /// Provider refunded the order on its side. Distinct from EXPIRED so the
  /// admin can tell a timed-out activation apart from a provider refund.
  REFUNDED
}

model Activation {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceSlug String
  serviceName String
  countrySlug String
  countryName String
  phoneNumber String
  /// What the customer paid.
  priceKobo  Int
  /// What the provider billed Xencodes for this exact order, captured at
  /// purchase time. Stored rather than recomputed because the provider's
  /// price moves: an order's margin has to be answerable later from what
  /// was true when it was placed.
  providerCostKobo Int @default(0)
  /// priceKobo minus providerCostKobo, stored for the same reason.
  markupKobo Int @default(0)
  status      ActivationStatus @default(WAITING)
  code        String?
  /// The provider's own id for this activation, used to poll for the SMS.
  externalId  String?
  expiresAt   DateTime
  receivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@map("activations")
}

enum WalletTransactionType {
  TOPUP
  PURCHASE
  REFUND
  /// Manual correction made by an admin, credit or debit.
  ADJUSTMENT
}

enum WalletTransactionStatus {
  /// Money has been asked for but not received. A pending row must never
  /// have contributed to the user's balance.
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
}

model WalletTransaction {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        WalletTransactionType
  amountKobo Int
  description String
  /// ISO 4217. Stored per row rather than assumed globally so a future
  /// second currency does not silently reinterpret old rows.
  currency    String                @default("NGN")
  /// Defaults to SUCCESSFUL because every row that existed before funding
  /// was introduced was an already-settled purchase, refund or adjustment.
  /// Only a top-up ever starts life PENDING.
  status      WalletTransactionStatus @default(SUCCESSFUL)
  /// The payment provider that owns this movement, for example "korapay".
  /// Null for internal movements like a purchase or an admin adjustment.
  provider    String?
  /// Our reference, generated before the provider is called and passed to
  /// it, so a webhook arriving later can be matched back to this exact row.
  /// Unique because it is what makes crediting idempotent.
  providerReference String?         @unique
  /// The provider's own id for the payment, recorded once it is known.
  providerTransactionId String?
  /// When the money actually landed, as distinct from when it was asked for.
  completedAt DateTime?
  failureReason String?
  createdAt   DateTime              @default(now())

  @@index([userId])
  @@index([status])
  @@map("wallet_transactions")
}

/// Admin override for a catalog service. Absent row means default (enabled, no markup).
model ServiceSetting {
  slug          String   @id
  enabled       Boolean  @default(true)
  markupPercent Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("service_settings")
}

/// Admin override for a catalog country.
model CountrySetting {
  slug      String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("country_settings")
}

/// Small key/value store for platform settings (global markup, provider config).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
